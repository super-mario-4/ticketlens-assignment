# Optional. `docker compose up --build` works without a .env file.
# To override a default, copy this file to .env and change the value.
# The defaults are for local use only.

# Host port for the API
API_PORT=8000

# PostgreSQL
POSTGRES_USER=ticketlens
POSTGRES_PASSWORD=ticketlens
POSTGRES_DB=ticketlens

# Elasticsearch heap size
ES_JAVA_OPTS=-Xms512m -Xmx512m
