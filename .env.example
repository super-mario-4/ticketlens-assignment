# Optional. `docker compose up --build` works without a .env file.
# To override a default, copy this file to .env and change the value.
# The defaults are for local use only.

# Host port for the API
API_PORT=8000

# Host port for the web screen
WEB_PORT=3000

# Demo accounts and token secret. Accounts are created at the first start.
JWT_SECRET=ticketlens-local-demo-secret-not-for-production
OPERATOR_PASSWORD=operator
LEAD_PASSWORD=lead

# PostgreSQL
POSTGRES_USER=ticketlens
POSTGRES_PASSWORD=ticketlens
POSTGRES_DB=ticketlens

# LLM runtime (ADR-0001). To use LM Studio on the host while developing, set
# LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_BASE_URL=http://llm:11434/v1
LLM_MODEL=qwen3.6:35b-a3b
LLM_TIMEOUT=60

# Parallel tickets in the worker, and parallel requests in the llm service
WORKER_CONCURRENCY=3

# Elasticsearch heap size
ES_JAVA_OPTS=-Xms512m -Xmx512m
